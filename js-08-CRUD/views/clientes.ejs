<%- include ('partials/header.ejs') %>
    <%- include ('partials/navbar.ejs') %>

        <!-- Formulário de cadastro de clientes -->
         <div class="container">
            <div class="card">
                <div class="card-header">
                    <h1>Cadastrar cliente</h1>
                </div>
                <div class="card-body">
                    <!-- action: para onde os dados serão enviados -->
                     <!--  method="POST": método http que envia dados de forma oculta -->
                    <form action="/clientes/cadastrar" method="post">
                        <label for="nome">Nome do cliente:</label>
                        <input type="text" id="nome" name="nome" placeholder="Insira o nome do cliente" class="form-control" required>

                        <label for="cpf">CPF do cliente:</label>
                        <input type="text" id="cpf" name="cpf" placeholder="Insira o CPF do cliente" class="form-control" required>

                        <label for="endereco">Endereço do cliente:</label>
                        <input type="text" name="endereco" id="endereco" placeholder="Insira o endereço do cliente" class="form-control" required>
                        <br>

                        <!-- Botão de cadastrar -->
                        <button type="submit" class="btn btn-success">Cadastrar</button>

                        <!-- Botão de limpar -->
                        <button type="reset" class="btn btn-danger">Limpar</button>
                    </form>
                </div>
            </div>
         </div>

        <div class="container">
            <div class="card">
                <div class="card-header">
                    <h1>Clientes</h1>
                </div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Nome:</th>
                                <th>CPF:</th>
                                <th>Endereço:</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% clientes.forEach(cliente=> { %>
                                <tr>
                                    <td><img src="images/avatar.png" width="30px"></td>
                                    <td>
                                        <%= cliente.nome %>
                                    </td>
                                    <td>
                                        <%= cliente.CPF %>
                                    </td>
                                    <td>
                                        <%= cliente.endereco %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <%- include ('partials/footer.ejs') %>
<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>
    <h4 style="text-align: center;">Página de Produtos!</h4>

    <!-- Chamando a variável para ser exibida na página -->
    <!-- Para transformar a variavel em comentario, deve se colocar um # dentro do codigo-->

    <!-- Percorrendo a lista de produtos através do forEach: -->
    <% produtos.forEach(produto => { %>
        <p>Produto: <%= produto.nome %></p>
        <p>Marca: <%= produto.marca %></p>
        <p>Preço: <%= produto.preco %></p>
    <% }) %>
<%- include ('partials/footer.ejs') %>